# Copie este arquivo para .streamlit/secrets.toml e preencha sua chave.
# NUNCA faça commit do arquivo secrets.toml real — ele já está no .gitignore.
#
# No Streamlit Community Cloud, cole este conteúdo em:
# App settings -> Secrets

ANTHROPIC_API_KEY = "sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Senha do painel Admin (onde você concede planos manualmente aos clientes).
ADMIN_PASSWORD = "escolha-uma-senha-forte"

# Token secreto que revela o link do Admin na navegação (sem ele, a aba nem existe).
# Guarde o link completo: https://seu-app.streamlit.app/admin?admin=SEU_TOKEN_AQUI
ADMIN_URL_TOKEN = "escolha-um-token-aleatorio"
